# Copy to .env.local; replace placeholders. Never commit .env.local.
# Shared recommendation credentials: run-recommender.ps1 exports the equivalent
# RECOMMENDER_SERVICE_TOKEN / RECOMMENDER_ADMIN_TOKEN for Python automatically.
Recommendation__ServiceUrl=http://127.0.0.1:8000
Recommendation__ServiceToken=REPLACE_WITH_LOCAL_SERVICE_TOKEN
Recommendation__AdminToken=REPLACE_WITH_DIFFERENT_LOCAL_ADMIN_TOKEN
# Values are literal: one KEY=value per line, optional matching quotes, no shell expansion.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5080
ConnectionStrings__Database=Host=localhost;Port=5432;Database=hutube;Username=hutube;Password=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
Jwt__SigningKey=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
Jwt__Issuer=HuTube
Jwt__Audience=HuTube.Clients
Auth__WebBaseUrl=http://localhost:4200
Auth__AdminBaseUrl=http://localhost:4201
# Optional when a local frontend calls the deployed Staging API.
Auth__AllowedOrigins__0=http://localhost:4200
Auth__AllowedOrigins__1=http://localhost:4201
Google__ClientId=REPLACE_WITH_GOOGLE_OAUTH_WEB_CLIENT_ID
# Legacy provider field for image storage; videos are routed to R2 by the dual storage adapter.
Storage__Provider=Cloudinary
Storage__CloudName=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
Storage__ApiKey=REPLACE_WITH_CLOUDINARY_API_KEY
Storage__ApiSecret=REPLACE_WITH_CLOUDINARY_API_SECRET
Storage__R2__AccountId=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
Storage__R2__AccessKeyId=REPLACE_WITH_R2_ACCESS_KEY_ID
Storage__R2__SecretAccessKey=REPLACE_WITH_R2_SECRET_ACCESS_KEY
Storage__R2__BucketName=hutube
Storage__R2__ReadUrlMinutes=60
# Optional read-only Cloudflare Account Analytics token for per-bucket R2 metrics.
CLOUDFLARE_API_TOKEN=
# Optional Upstash Redis REST credentials for notification HybridCache (RAM 5s / Redis 30s),
# session player preferences and the persistent encrypted Data Protection key ring.
# Legacy Redis__Endpoint (HTTPS) / Redis__Password are also accepted. Redis__Enabled=false disables Redis.
# Keep the encryption secret stable across deployments. It defaults to Jwt__SigningKey;
# set a dedicated secret before the first Redis-backed deployment to rotate JWT keys independently.
# DataProtection__EncryptionKey=
# Use a read/write REST token; keep these credentials on the backend only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VideoProcessing__Enabled=true
VideoProcessing__FfmpegPath=ffmpeg
Features__ModerationEnabled=true
Features__PlanEnforcementEnabled=true
Email__Mode=Pickup
Email__PickupDirectory=.work/mail
# Staging/Production: Email__Mode=Smtp and configure Email__From, Email__Host,
# Email__Port (587 STARTTLS or 465 TLS), Email__Username, Email__Password via secrets.
# The backend's Development defaults select the ignored email pickup directory.
# Test login needs CREATEDB; integration tests must never target application data.
TEST_DATABASE_CONNECTION=Host=localhost;Port=5432;Database=hutube_test;Username=hutube_test;Password=REPLACE_WITH_SEPARATE_TEST_PASSWORD
API_BASE_URL=http://localhost:5080/api/v1
RECOMMENDATION_BASE_URL=http://localhost:8000/api/v1
HUTUBE_API_BASE_URL=http://127.0.0.1:5080/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]
MOBILE_API_BASE_URL=http://10.0.2.2:5080/api/v1
MOBILE_RECOMMENDATION_BASE_URL=http://10.0.2.2:8000/api/v1
# Optional Docker PostgreSQL on port 5433 (does not replace native PostgreSQL).
POSTGRES_USER=hutube
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
POSTGRES_DB=hutube
POSTGRES_PORT=5433
# SePay bank-transfer checkout. Keep the webhook secret in .env.local or a deployment secret store.
SePay__SecretKey=REPLACE_WITH_SEPAY_SECRET_KEY
SePay__AccountNumber=REPLACE_WITH_BANK_ACCOUNT_NUMBER
SePay__BankCode=REPLACE_WITH_BANK_CODE
SePay__PaymentExpiryMinutes=30
SePay__TransactionCodePrefix=HUTUBE

# Google Forms survey completion sync. Configure the bound Apps Script first.
# Popup is inactive until both a valid entry ID and a secret of at least 32 characters exist.
FeedbackSurvey__Enabled=true
FeedbackSurvey__TokenEntryId=
FeedbackSurvey__WebhookSecret=

# Durable moderation notifications. Password is shared by API and broker.
RABBITMQ_USER=dalitu
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_BROKER_PASSWORD
RabbitMq__Enabled=true
RabbitMq__HostName=127.0.0.1
RabbitMq__Port=5672
RabbitMq__UserName=dalitu
RabbitMq__Password=REPLACE_WITH_RANDOM_BROKER_PASSWORD
RabbitMq__VirtualHost=dalitu
# FCM is optional until Firebase credentials and the Mobile app are configured.
Fcm__Enabled=false
Fcm__ProjectId=
Fcm__CredentialsPath=
