# Copy to .env.local; replace placeholders. Never commit .env.local.
# Values are literal: one KEY=value per line, optional matching quotes, no shell expansion.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5080
ConnectionStrings__Database=Host=localhost;Port=5432;Database=hutube;Username=hutube;Password=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
Jwt__SigningKey=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
Jwt__Issuer=HuTube
Jwt__Audience=HuTube.Clients
Auth__WebBaseUrl=http://localhost:4200
Auth__AdminBaseUrl=http://localhost:4201
Google__ClientId=REPLACE_WITH_GOOGLE_OAUTH_WEB_CLIENT_ID
Email__Mode=Pickup
Email__PickupDirectory=.work/mail
# Staging/Production: Email__Mode=Smtp and configure Email__From, Email__Host,
# Email__Port (587 STARTTLS or 465 TLS), Email__Username, Email__Password via secrets.
# The backend's Development defaults select the ignored email pickup directory.
# Test login needs CREATEDB; integration tests must never target application data.
TEST_DATABASE_CONNECTION=Host=localhost;Port=5432;Database=hutube_test;Username=hutube_test;Password=REPLACE_WITH_SEPARATE_TEST_PASSWORD
API_BASE_URL=http://localhost:5080/api/v1
MOBILE_API_BASE_URL=http://10.0.2.2:5080/api/v1
# Optional Docker PostgreSQL on port 5433 (does not replace native PostgreSQL).
POSTGRES_USER=hutube
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
POSTGRES_DB=hutube
POSTGRES_PORT=5433
