APP_ENV=development
# Content API is used only for session validation, watch history and video cards.
HUTUBE_API_BASE_URL=http://127.0.0.1:5080/api/v1
CORS_ALLOWED_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","https://hutube-beta.vercel.app"]
MODEL_STORAGE_PATH=data/artifacts
MODEL_VERSION=benchmark-latest
# Valid: user_based_cosine/user_based_jaccard/user_based_pearson or
#        item_based_cosine/item_based_jaccard/item_based_pearson.
# Legacy item_based/user_based aliases mean the cosine variant.
MODEL_TYPE=item_based_cosine
RECOMMENDER_SERVICE_TOKEN=REPLACE_WITH_LOCAL_SERVICE_TOKEN
# Must equal the API's Recommendation__AdminToken. When using the PowerShell
# launcher, .env.local is authoritative and these token values are overridden.
RECOMMENDER_ADMIN_TOKEN=REPLACE_WITH_DIFFERENT_LOCAL_ADMIN_TOKEN
R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=hutube
ALLOW_BENCHMARK_MODEL=true
