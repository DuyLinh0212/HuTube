{
  "outputDirectory": "dist/admin-web/browser",
  "routes": [
    { "src": "/config\\.json$", "headers": { "Cache-Control": "no-store" }, "continue": true },
    { "src": "/(?:index\\.html)?$", "headers": { "Cache-Control": "no-store" }, "continue": true },
    { "handle": "filesystem" },
    {
      "src": "/.*\\.[^/]+$",
      "status": 404,
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "src": "/.*",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-store" }
    }
  ]
}
